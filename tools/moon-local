#!/bin/sh
set -eu
medseal_repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
medseal_local_home="$medseal_repo/../moonbit工具链"
if [ -x "$medseal_local_home/bin/moon" ]; then
  MOON_HOME="$medseal_local_home"
  export MOON_HOME
  PATH="$MOON_HOME/bin:$PATH"
fi
medseal_node="${MEDSEAL_NODE_BIN:-$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin}"
if [ -x "$medseal_node/node" ]; then
  PATH="$medseal_node:$PATH"
fi
export PATH
if [ "$(uname -s)" = Darwin ] && [ -z "${SDKROOT:-}" ] && [ -d /Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk ]; then
  SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk
  export SDKROOT
fi
cd "$medseal_repo"
exec moon "$@"
